{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.0",
        "laravel/scout": "^11.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.9",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^13.0",
        "spatie/icalendar-generator": "^3.1",
        "spatie/laravel-permission": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-browser": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Accounting\\": "Modules/Accounting/app/",
            "Modules\\Accounting\\Database\\Factories\\": "Modules/Accounting/database/factories/",
            "Modules\\Accounting\\Database\\Seeders\\": "Modules/Accounting/database/seeders/",
            "Modules\\Admission\\": "Modules/Admission/app/",
            "Modules\\Admission\\Database\\Factories\\": "Modules/Admission/database/factories/",
            "Modules\\Admission\\Database\\Seeders\\": "Modules/Admission/database/seeders/",
            "Modules\\Curriculum\\": "Modules/Curriculum/app/",
            "Modules\\Curriculum\\Database\\Factories\\": "Modules/Curriculum/database/factories/",
            "Modules\\Curriculum\\Database\\Seeders\\": "Modules/Curriculum/database/seeders/",
            "Modules\\Guidance\\": "Modules/Guidance/app/",
            "Modules\\Guidance\\Database\\Factories\\": "Modules/Guidance/database/factories/",
            "Modules\\Guidance\\Database\\Seeders\\": "Modules/Guidance/database/seeders/",
            "Modules\\HR\\": "Modules/HR/app/",
            "Modules\\HR\\Database\\Factories\\": "Modules/HR/database/factories/",
            "Modules\\HR\\Database\\Seeders\\": "Modules/HR/database/seeders/",
            "Modules\\Library\\": "Modules/Library/app/",
            "Modules\\Library\\Database\\Factories\\": "Modules/Library/database/factories/",
            "Modules\\Library\\Database\\Seeders\\": "Modules/Library/database/seeders/",
            "Modules\\Registrar\\": "Modules/Registrar/app/",
            "Modules\\Registrar\\Database\\Factories\\": "Modules/Registrar/database/factories/",
            "Modules\\Registrar\\Database\\Seeders\\": "Modules/Registrar/database/seeders/",
            "Modules\\Research\\": "Modules/Research/app/",
            "Modules\\Research\\Database\\Factories\\": "Modules/Research/database/factories/",
            "Modules\\Research\\Database\\Seeders\\": "Modules/Research/database/seeders/",
            "Modules\\SAS\\": "Modules/SAS/app/",
            "Modules\\SAS\\Database\\Factories\\": "Modules/SAS/database/factories/",
            "Modules\\SAS\\Database\\Seeders\\": "Modules/SAS/database/seeders/",
            "Modules\\USG\\": "Modules/USG/app/",
            "Modules\\USG\\Database\\Factories\\": "Modules/USG/database/factories/",
            "Modules\\USG\\Database\\Seeders\\": "Modules/USG/database/seeders/",
            "Modules\\VotingSystem\\": "Modules/VotingSystem/app/",
            "Modules\\VotingSystem\\Database\\Factories\\": "Modules/VotingSystem/database/factories/",
            "Modules\\VotingSystem\\Database\\Seeders\\": "Modules/VotingSystem/database/seeders/",
            "Modules\\Scheduling\\": "Modules/Scheduling/app/",
            "Modules\\Scheduling\\Database\\Factories\\": "Modules/Scheduling/database/factories/",
            "Modules\\Scheduling\\Database\\Seeders\\": "Modules/Scheduling/database/seeders/",
            "Modules\\Facilities\\": "Modules/Facilities/app/",
            "Modules\\Facilities\\Database\\Factories\\": "Modules/Facilities/database/factories/",
            "Modules\\Facilities\\Database\\Seeders\\": "Modules/Facilities/database/seeders/",
            "Modules\\Discipline\\": "Modules/Discipline/app/",
            "Modules\\Discipline\\Database\\Factories\\": "Modules/Discipline/database/factories/",
            "Modules\\Discipline\\Database\\Seeders\\": "Modules/Discipline/database/seeders/",
            "Modules\\Helpdesk\\": "Modules/Helpdesk/app/",
            "Modules\\Helpdesk\\Database\\Factories\\": "Modules/Helpdesk/database/factories/",
            "Modules\\Helpdesk\\Database\\Seeders\\": "Modules/Helpdesk/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Accounting\\Tests\\": "Modules/Accounting/tests/",
            "Modules\\Admission\\Tests\\": "Modules/Admission/tests/",
            "Modules\\Curriculum\\Tests\\": "Modules/Curriculum/tests/",
            "Modules\\Guidance\\Tests\\": "Modules/Guidance/tests/",
            "Modules\\HR\\Tests\\": "Modules/HR/tests/",
            "Modules\\Library\\Tests\\": "Modules/Library/tests/",
            "Modules\\Registrar\\Tests\\": "Modules/Registrar/tests/",
            "Modules\\Research\\Tests\\": "Modules/Research/tests/",
            "Modules\\SAS\\Tests\\": "Modules/SAS/tests/",
            "Modules\\USG\\Tests\\": "Modules/USG/tests/",
            "Modules\\VotingSystem\\Tests\\": "Modules/VotingSystem/tests/",
            "Modules\\Scheduling\\Tests\\": "Modules/Scheduling/tests/",
            "Modules\\Facilities\\Tests\\": "Modules/Facilities/tests/",
            "Modules\\Discipline\\Tests\\": "Modules/Discipline/tests/",
            "Modules\\Helpdesk\\Tests\\": "Modules/Helpdesk/tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "./vendor/bin/pest",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models --nowrite",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}